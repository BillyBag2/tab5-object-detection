# Loaded explicitly by CMakeLists.txt (the requested singular filename).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Application C/C++ is promoted to -O3 by cmake/optimization.cmake.
# The bootloader has a small fixed flash slot; retain its supported size setting.
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Larger working-set cache; consumes 128 KiB more internal SRAM than 128 KiB.
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# Original ILI9881C panel: 40/50 MHz trials were unstable; retain native timing.
CONFIG_TAB5_LCD_PIXEL_CLOCK_MHZ=60
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Tab5 MIPI camera and ISP (automatic exposure / white balance).
CONFIG_CAMERA_SC202CS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# Retain ACC for black-level and saturation settings. The custom profile omits
# only CCM matrices, whose product with AWB gains can exceed P4's +/-4 limit.
CONFIG_ESP_IPA_ACC_ALGORITHM=y
# CONFIG_CAMERA_SC202CS_DEFAULT_IPA_JSON_CONFIGURATION_FILE is not set
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="config/sc202cs_tab5.json"
# CONFIG_CAM_CTRL_SPI_ENABLE is not set
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set

# INT8 COCO 80-class YOLO11 nano, 320 input; embed weights in firmware.
# CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V1 is not set
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_MODEL_IN_FLASH_RODATA=y

CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
